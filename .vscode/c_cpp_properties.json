{
    "version": 4,
    "configurations": [
        {
            "name": "kiriyama_canvas (Emscripten / C++23)",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/math/include",
                "${workspaceFolder}/core/include",
                "${workspaceFolder}/platform/src/include",
                "${workspaceFolder}/platform/web/include",
                "${workspaceFolder}/third_parts/SDL/include",
                "${workspaceFolder}/third_parts/SDL_ttf/include",
                "${workspaceFolder}/third_parts/googletest/googletest/include",
                "${workspaceFolder}/build/generated"
            ],
            "cStandard": "c17",
            "cppStandard": "c++23",
            "intelliSenseMode": "windows-clang-x64"
        }
    ]
}
